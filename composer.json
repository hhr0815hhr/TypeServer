{
    "name": "typephp/tsf",
    "description": "TSF — TypePHP Server Framework：用 TypePHP(AOT) + PHP 构建高性能游戏服务器",
    "type": "library",
    "license": "MIT",
    "keywords": ["game-server", "framework", "aot", "typephp", "swoole"],
    "require": {
        "php": ">=8.5"
    },
    "autoload": {
        "psr-4": {
            "TSF\\": "tsf/src/"
        }
    },
    "bin": [
        "tsf/bin/tsf"
    ],
    "archive": {
        "exclude": [
            "/bench",
            "/tests",
            "/spike",
            "/dist",
            "/docs",
            "/implementation-kit",
            "/tpc-patches",
            "/.github",
            "/demo",
            "/.workbuddy"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
