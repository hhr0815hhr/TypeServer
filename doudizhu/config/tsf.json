{
    "app": { "name": "doudizhu" },
    "log": { "level": "info", "file": "${base}/var/log/app.log" },
    "protocol": { "frame": "native", "payload": "json" },
    "db": { "dsn": "sqlite:${base}/var/ddz.db" },
    "server": {
        "host": "0.0.0.0",
        "port": 9301,
        "transport": "ws",
        "worker_num": 1,
        "max_conn": 200,
        "nodelay": true,
        "heartbeat_sec": 60,
        "rate_per_sec": 100,
        "rate_burst": 200,
        "auth": {
            "require": true,
            "secret": "ddz-dev-secret",
            "tokens": {
                "tok-a": 1001,
                "tok-b": 1002,
                "tok-c": 1003
            }
        }
    }
}
